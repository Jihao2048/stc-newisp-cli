# Line-ending and encoding policy.
#
# This is a cross-platform project, so the repository stores text with Unix
# line endings regardless of which machine edited it. Without this file a
# Windows checkout would write CRLF back into the tree on the next commit and
# the diffs would churn.
#
# Normalisation is applied on check-in, and everything is checked out with LF.
# GCC and Clang require that for the shell scripts to work, and MSVC accepts LF
# happily -- so one choice suits all three platforms.

* text=auto eol=lf

# C and C++ sources.
*.c      text eol=lf
*.cc     text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf

# Build system.
CMakeLists.txt text eol=lf
*.cmake  text eol=lf

# Documentation and data.
*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Scripts. The shell scripts must be LF or Linux and macOS report
# "bad interpreter"; the others are kept consistent with them.
*.sh     text eol=lf
*.ps1    text eol=lf
*.py     text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Binary files: never convert these.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.tar    binary
*.hex    binary
*.bin    binary
*.elf    binary
*.exe    binary
*.dll    binary
*.lib    binary
*.so     binary
*.dylib  binary
*.a      binary
*.o      binary
*.obj    binary
*.pdb    binary
